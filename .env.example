# ===== LLM 配置 =====
# LLM 提供商: qwen (百炼 OpenAI 兼容) 或 dashscope (DashScope SDK)
LLM_PROVIDER=qwen

# 千问百炼 API Key (OpenAI 兼容模式 + DashScope 共用同一 Key)
QWEN_API_KEY=your_qwen_api_key
QWEN_API_BASE=https://your-bailian-endpoint/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus

# DashScope API Key (与 QWEN_API_KEY 可共用)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_API_BASE=https://your-bailian-endpoint/api/v1

# 商汤科技 SenseNova API Key (LLM、图片生成)
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 商汤科技 SenseNova API Key (LLM、图片生成)
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 可灵AI API Key (视频生成)
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# ===== LangSmith 追踪配置 (可选) =====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=agent-part

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ===== 存储配置 =====
STORAGE_TYPE=local
STORAGE_PATH=./output

# ===== 日志配置 =====
LOG_LEVEL=INFO

# ===== PostgreSQL 配置 =====
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/agent_part

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== RAG 配置 =====
RAG_ENABLED=true
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=BAAI/bge-large-zh
EMBEDDING_DEVICE=cpu
VECTOR_DIMENSION=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ===== RAG 高级配置 =====
# Query 改写
RAG_QUERY_REWRITING_ENABLED=false
RAG_QUERY_REWRITING_MODE=single
RAG_QUERY_REWRITING_MAX_VARIANTS=3
RAG_HYDE_ENABLED=false

# Cross-Encoder 重排序
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TOP_K=5
RAG_RERANKER_DEVICE=auto

# 混合检索 (Dense+Sparse+ColBERT)
RAG_HYBRID_RETRIEVAL_ENABLED=false
RAG_HYBRID_MODEL=BAAI/bge-m3
RAG_HYBRID_DENSE_WEIGHT=0.4
RAG_HYBRID_SPARSE_WEIGHT=0.3
RAG_HYBRID_COLBERT_WEIGHT=0.3
RAG_HYBRID_RRF_K=60

# ===== Mock 资产降级 =====
ALLOW_MOCK_ASSETS=true

# ===== 数据库 schema 管理 =====
# 启动时是否自动 create_all 建表（开发便利）。生产建议 False 并使用 Alembic：
#   uv run alembic upgrade head     # 全新库
#   uv run alembic stamp head       # 已用 create_all 建过表的存量库（后续增量迁移）
DB_AUTO_CREATE=true

# ===== 向量维度 =====
# knowledge_docs / knowledge_chunks / GraphRAG 等表的 Vector(N) 列宽。
# 更换 Embedding 模型后需调整本值并通过 Alembic 迁移变更列类型。
# BGE-large-zh=1024；qwen text-embedding-v3 支持 768/1024/1536
EMBEDDING_DIMENSION=1024

# ===== LLM 调用重试 =====
# 调用失败后的重试次数（不含首次，0 表示不重试）与初始退避秒数（指数退避）
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_INITIAL_BACKOFF=1.0
