# =============================================================================
# Agent Part 环境变量契约（复制为 .env，勿提交仓库）
# 生产必填项见下方「生产必填」分组；缺省 fail-closed。
# =============================================================================

# -----------------------------------------------------------------------------
# 生产必填（内部运营 Compose）
# -----------------------------------------------------------------------------
# 平台凭证加密密钥（Fernet）。未配置时写入平台凭证会 fail closed。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# API Token 注册表（JSON）。只存 sha256 哈希，不接受明文 token 字段。
# 示例：{"tokens":[{"name":"ops","token_sha256":"<hex>","scopes":["*"],"tenant_id":"default"}]}
# 解析失败启动时 503 fail closed。
AUTH_API_TOKENS_JSON=

# 厂商 Key（或改用 model_providers 表配置 Provider）
QWEN_API_KEY=

# CORS 必须为具体域名，禁止空列表或 *（启动校验会拒绝）
CORS_ALLOW_ORIGINS=http://localhost:3000

# 生产关闭 mock 与调试
ALLOW_MOCK_ASSETS=false
DEBUG=false
DB_AUTO_CREATE=false

# -----------------------------------------------------------------------------
# PostgreSQL（应用只读分项，没有 DATABASE_URL）
# Compose 内由 docker-compose.yml 注入 POSTGRES_HOST=postgres
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=agent_part

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 服务
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# 厂商与模型（可选：也可走 model_providers 表）
# =============================================================================
LLM_PROVIDER=qwen
QWEN_API_BASE=https://your-bailian-endpoint/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://your-bailian-endpoint/api/v1
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# LangSmith 追踪（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-part

# 存储
STORAGE_TYPE=local
STORAGE_PATH=./output

# =============================================================================
# RAG
# =============================================================================
RAG_ENABLED=true
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-zh
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ===== RAG 高级配置 =====
# Query 改写
QUERY_REWRITING_ENABLED=false
QUERY_REWRITING_MODE=single
QUERY_REWRITING_MAX_VARIANTS=3
HYDE_ENABLED=false

# Cross-Encoder 重排序
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5
RERANKER_DEVICE=auto

# 混合检索 (Dense+Sparse+ColBERT)
HYBRID_RETRIEVAL_ENABLED=false
HYBRID_MODEL=BAAI/bge-m3
HYBRID_DENSE_WEIGHT=0.4
HYBRID_SPARSE_WEIGHT=0.3
HYBRID_COLBERT_WEIGHT=0.3
HYBRID_RRF_K=60

LLM_RETRY_ATTEMPTS=2
LLM_RETRY_INITIAL_BACKOFF=1.0

# 鉴权总开关（生产必须 true）
AUTH_ENABLED=true
# WebSocket 是否允许 query token（生产建议 false）
AUTH_ALLOW_WS_QUERY_TOKEN=false
